@baseUrl = http://localhost:5000/api/v1
@testName = {{$dotenv MADURAA_TEST_NAME}}
@testEmail = {{$dotenv MADURAA_TEST_EMAIL}}
@testPassword = {{$dotenv MADURAA_TEST_PASSWORD}}

### Register a test account (run only when a new account is needed).
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "{{testName}}",
  "email": "{{testEmail}}",
  "password": "{{testPassword}}"
}

### Login
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{testEmail}}",
  "password": "{{testPassword}}"
}

### Run login first, then send protected requests.
@token = {{login.response.body.token}}

GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

###
GET {{baseUrl}}/auth/profile
Authorization: Bearer {{token}}

### Categories
GET {{baseUrl}}/categories
Authorization: Bearer {{token}}

### Products
GET {{baseUrl}}/products
Authorization: Bearer {{token}}

### Transactions
GET {{baseUrl}}/transactions
Authorization: Bearer {{token}}

### Dashboard summary
GET {{baseUrl}}/dashboard/summary
Authorization: Bearer {{token}}

### Sales report
GET {{baseUrl}}/reports/sales?type=monthly
Authorization: Bearer {{token}}
