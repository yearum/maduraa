PORT=5000
# JWT_SECRET harus berupa string acak minimal 32 karakter.
JWT_SECRET=ganti_dengan_string_acak_minimal_32_karakter
DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_SSL=true
# Sertifikat CA opsional untuk koneksi SSL di production
DATABASE_CA=
CLIENT_URL=http://localhost:5173
NODE_ENV=development
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=isi_password_owner
CASHIER_EMAIL=cashier@example.com
CASHIER_PASSWORD=isi_password_cashier
